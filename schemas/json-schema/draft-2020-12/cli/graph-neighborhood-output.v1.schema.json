{
  "$defs": {
    "ApiExecutionPlanState": {
      "enum": [
        "unplanned",
        "planned",
        "not_required"
      ],
      "type": "string"
    },
    "ApiLabel": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "type": "string"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "board_id",
        "name",
        "color",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "ApiTask": {
      "additionalProperties": false,
      "properties": {
        "archived_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        },
        "board_id": {
          "type": "string"
        },
        "board_slug": {
          "type": "string"
        },
        "claim_expires_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "claim_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "completed_required_step_count": {
          "format": "int64",
          "type": "integer"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "created_by": {
          "type": "string"
        },
        "current_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependency_blocked": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "execution_plan_state": {
          "$ref": "#/$defs/ApiExecutionPlanState"
        },
        "id": {
          "type": "string"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/ApiLabel"
          },
          "type": "array"
        },
        "last_heartbeat_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lock_version": {
          "format": "int64",
          "type": "integer"
        },
        "max_retries": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "metadata": true,
        "optional_step_count": {
          "format": "int64",
          "type": "integer"
        },
        "position": {
          "format": "int64",
          "type": "integer"
        },
        "priority": {
          "$ref": "#/$defs/ApiTaskPriority"
        },
        "ref": {
          "type": "string"
        },
        "required_step_count": {
          "format": "int64",
          "type": "integer"
        },
        "result": true,
        "result_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_count": {
          "format": "int64",
          "type": "integer"
        },
        "scheduled_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "started_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ApiTaskStatus"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "unfinished_parent_count": {
          "format": "int64",
          "type": "integer"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "board_id",
        "board_slug",
        "ref",
        "seq",
        "title",
        "description",
        "status",
        "status_reason",
        "assignee",
        "priority",
        "position",
        "scheduled_at",
        "due_at",
        "created_by",
        "created_at",
        "updated_at",
        "started_at",
        "completed_at",
        "archived_at",
        "claim_owner",
        "claim_expires_at",
        "last_heartbeat_at",
        "current_run_id",
        "retry_count",
        "max_retries",
        "result_summary",
        "result",
        "metadata",
        "lock_version",
        "dependency_blocked",
        "unfinished_parent_count",
        "execution_plan_state",
        "required_step_count",
        "completed_required_step_count",
        "optional_step_count",
        "labels"
      ],
      "type": "object"
    },
    "ApiTaskGraphEdgeKind": {
      "enum": [
        "dependency",
        "step"
      ],
      "type": "string"
    },
    "ApiTaskGraphNodeRole": {
      "enum": [
        "center",
        "dependency_parent",
        "dependency_child",
        "step_parent",
        "step_child",
        "active",
        "context"
      ],
      "type": "string"
    },
    "ApiTaskPriority": {
      "format": "uint8",
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "ApiTaskStatus": {
      "enum": [
        "triage",
        "todo",
        "scheduled",
        "ready",
        "running",
        "blocked",
        "review",
        "done",
        "archived"
      ],
      "type": "string"
    },
    "TaskGraphEdge": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ApiTaskGraphEdgeKind"
        },
        "required": {
          "type": "boolean"
        },
        "source_task_id": {
          "type": "string"
        },
        "target_task_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_task_id",
        "target_task_id",
        "kind",
        "required",
        "blocking"
      ],
      "type": "object"
    },
    "TaskGraphMeta": {
      "additionalProperties": false,
      "properties": {
        "active_only": {
          "type": "boolean"
        },
        "active_statuses": {
          "items": {
            "$ref": "#/$defs/ApiTaskStatus"
          },
          "type": "array"
        },
        "context_depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "edge_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "generated_at": {
          "format": "int64",
          "type": "integer"
        },
        "hide_isolated": {
          "type": "boolean"
        },
        "include_archived_context": {
          "type": "boolean"
        },
        "include_done_context": {
          "type": "boolean"
        },
        "limit_nodes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "node_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "depth",
        "context_depth",
        "generated_at",
        "node_count",
        "edge_count",
        "truncated",
        "active_statuses",
        "active_only",
        "include_done_context",
        "include_archived_context",
        "hide_isolated",
        "limit_nodes"
      ],
      "type": "object"
    },
    "TaskGraphNode": {
      "additionalProperties": false,
      "properties": {
        "context_only": {
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/ApiTaskGraphNodeRole"
        },
        "task": {
          "$ref": "#/$defs/ApiTask"
        }
      },
      "required": [
        "task",
        "role",
        "context_only"
      ],
      "type": "object"
    },
    "TaskNeighborhood": {
      "additionalProperties": false,
      "properties": {
        "center_task_id": {
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/TaskGraphEdge"
          },
          "type": "array"
        },
        "meta": {
          "$ref": "#/$defs/TaskGraphMeta"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/TaskGraphNode"
          },
          "type": "array"
        }
      },
      "required": [
        "center_task_id",
        "nodes",
        "edges",
        "meta"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:cli:graph-neighborhood-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/TaskNeighborhood"
    }
  },
  "required": [
    "data"
  ],
  "title": "Kanban CLI graph neighborhood output v1",
  "type": "object"
}
