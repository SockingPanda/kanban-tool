{
  "$defs": {
    "ApiCycleStatus": {
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "$id": "urn:kanban-tool:schema:api:list-cycles-query:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "include_archived": {
      "default": false,
      "type": "boolean"
    },
    "limit": {
      "default": 100,
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "q": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiCycleStatus"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "api.list-cycles.query",
  "type": "object"
}
