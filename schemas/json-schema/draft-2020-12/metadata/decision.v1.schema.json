{
  "$defs": {
    "DecisionOption": {
      "additionalProperties": true,
      "properties": {
        "detail": {
          "minLength": 1,
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "slug",
        "title",
        "detail"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:metadata:decision:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "options": {
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "minItems": 1,
      "type": "array"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "risk": {
      "minLength": 1,
      "type": "string"
    },
    "selected": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "options",
    "selected",
    "reason"
  ],
  "title": "Kanban decision metadata v1",
  "type": "object"
}
