      "enum": [
        "descriptor",
        "prepare_snapshot",
        "apply_batch",
        "publish",
        "inspect_active",
        "inspect_generation",
        "validate_generation_publication",
        "validate_active_contents",
        "repair_publication",
        "quarantine",
        "abort",
        "inventory",
        "cleanup"
