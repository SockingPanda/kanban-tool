{
  "$defs": {
    "CliMaintenanceMode": {
      "enum": [
        "once",
        "continuous"
      ],
      "type": "string"
    },
    "CliMaintenanceRun": {
      "additionalProperties": false,
      "properties": {
        "database_instance_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/CliMaintenanceMode"
        },
        "owner": {
          "type": "string"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "stores": {
          "items": {
            "$ref": "#/$defs/CliMaintenanceStoreRun"
          },
          "type": "array"
        }
      },
      "required": [
        "database_instance_id",
        "protocol_version",
        "owner",
        "mode",
        "stores"
      ],
      "type": "object"
    },
    "CliMaintenanceStoreRun": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle_status": {
          "type": "string"
        },
        "processed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "store_name": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "action",
        "processed",
        "lifecycle_status",
        "fallback_reason"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:cli:maintenance-run-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/CliMaintenanceRun"
    }
  },
  "required": [
    "data"
  ],
  "title": "Kanban CLI maintenance run output v1",
  "type": "object"
}
