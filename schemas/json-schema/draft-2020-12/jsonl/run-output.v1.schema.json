{
  "$defs": {
    "PortableNever": {
      "description": "无 inhabitant 的值让必需的可空字段只能接受 JSON null。",
      "not": {}
    },
    "PortableRunStatus": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "canceled",
        "expired"
      ],
      "type": "string"
    },
    "RequiredNullableSchema": {
      "description": "仅供 schema 使用的标记，表示 key 必须存在但可以包含 JSON null。\n\nschemars 会把裸 `Option<T>` 视为可省略，而 `#[schemars(required)]` 会有意移除\nnull 分支。这个透明的非 Option wrapper 保留 wire contract 的两部分。",
      "type": [
        "string",
        "null"
      ]
    },
    "RequiredNullableSchema2": {
      "description": "仅供 schema 使用的标记，表示 key 必须存在但可以包含 JSON null。\n\nschemars 会把裸 `Option<T>` 视为可省略，而 `#[schemars(required)]` 会有意移除\nnull 分支。这个透明的非 Option wrapper 保留 wire contract 的两部分。",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "RequiredNullableSchema3": {
      "anyOf": [
        {
          "$ref": "#/$defs/PortableNever"
        },
        {
          "type": "null"
        }
      ],
      "description": "仅供 schema 使用的标记，表示 key 必须存在但可以包含 JSON null。\n\nschemars 会把裸 `Option<T>` 视为可省略，而 `#[schemars(required)]` 会有意移除\nnull 分支。这个透明的非 Option wrapper 保留 wire contract 的两部分。"
    },
    "RunJsonlData": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "type": "string"
        },
        "claim_expires_at": {
          "format": "int64",
          "type": "integer"
        },
        "claim_owner": {
          "type": "string"
        },
        "claim_token": {
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/RequiredNullableSchema"
        },
        "exit_code": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "finished_at": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "id": {
          "type": "string"
        },
        "last_heartbeat_at": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "log_path": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        },
        "metadata": true,
        "started_at": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PortableRunStatus"
        },
        "summary": {
          "$ref": "#/$defs/RequiredNullableSchema"
        },
        "task_id": {
          "type": "string"
        },
        "worker_pid": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "worker_profile": {
          "$ref": "#/$defs/RequiredNullableSchema"
        }
      },
      "required": [
        "id",
        "board_id",
        "task_id",
        "status",
        "worker_profile",
        "worker_pid",
        "claim_token",
        "claim_owner",
        "claim_expires_at",
        "started_at",
        "last_heartbeat_at",
        "finished_at",
        "exit_code",
        "summary",
        "error",
        "log_path",
        "metadata"
      ],
      "type": "object"
    },
    "RunJsonlType": {
      "enum": [
        "run"
      ],
      "type": "string"
    }
  },
  "$id": "urn:kanban-tool:schema:jsonl:run-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/RunJsonlData"
    },
    "type": {
      "$ref": "#/$defs/RunJsonlType"
    }
  },
  "required": [
    "type",
    "data"
  ],
  "title": "Kanban JSONL run output v1",
  "type": "object"
}
