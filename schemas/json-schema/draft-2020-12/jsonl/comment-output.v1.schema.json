{
  "$defs": {
    "CommentAuthorType": {
      "enum": [
        "user",
        "agent"
      ],
      "type": "string"
    },
    "CommentJsonlData": {
      "additionalProperties": false,
      "properties": {
        "agent_type": {
          "$ref": "#/$defs/RequiredNullableSchema"
        },
        "author": {
          "type": "string"
        },
        "author_type": {
          "$ref": "#/$defs/CommentAuthorType"
        },
        "board_id": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CommentKind"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "board_id",
        "task_id",
        "author",
        "author_type",
        "agent_type",
        "body",
        "kind",
        "metadata",
        "created_at"
      ],
      "type": "object"
    },
    "CommentJsonlType": {
      "enum": [
        "comment"
      ],
      "type": "string"
    },
    "CommentKind": {
      "enum": [
        "note",
        "decision",
        "signal"
      ],
      "type": "string"
    },
    "RequiredNullableSchema": {
      "description": "仅供 schema 使用的标记，表示 key 必须存在但可以包含 JSON null。\n\nschemars 会把裸 `Option<T>` 视为可省略，而 `#[schemars(required)]` 会有意移除\nnull 分支。这个透明的非 Option wrapper 保留 wire contract 的两部分。",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "urn:kanban-tool:schema:jsonl:comment-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/CommentJsonlData"
    },
    "type": {
      "$ref": "#/$defs/CommentJsonlType"
    }
  },
  "required": [
    "type",
    "data"
  ],
  "title": "Kanban JSONL comment output v1",
  "type": "object"
}
