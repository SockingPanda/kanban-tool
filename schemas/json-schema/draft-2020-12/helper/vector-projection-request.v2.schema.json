          "type": "string"
        }
      },
      "required": [
        "request_id",
        "projection_store",
        "generation_id"
      ],
      "type": "object"
    },
    "VectorProjectionInventoryRequest": {
      "additionalProperties": false,
      "properties": {
        "projection_store": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "projection_store"
      ],
      "type": "object"
    },
    "VectorProjectionMutationContext": {
      "additionalProperties": false,
      "properties": {
        "delivery_digest": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "projection_store": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "projection_store",
        "generation_id",
        "delivery_digest"
