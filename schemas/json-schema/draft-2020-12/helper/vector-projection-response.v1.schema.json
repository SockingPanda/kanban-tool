    "ProjectionArtifactEvidence": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ProjectionArtifactManifest"
        }
      },
      "required": [
        "manifest",
        "fingerprint"
      ],
      "type": "object"
    },
    "ProjectionArtifactManifest": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest": {
          "type": "string"
        },
        "canonical_item_count": {
          "format": "int64",
          "type": "integer"
        },
        "corpus": {
          "$ref": "#/$defs/RequiredNullableSchema"
        },
        "database_instance_id": {
          "type": "string"
        },
        "delivery_digest": {
          "type": "string"
        },
        "delivery_item_count": {
          "format": "int64",
          "type": "integer"
        },
        "fence_epoch": {
          "format": "int64",
          "type": "integer"
        },
        "fingerprint": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "generation": {
          "type": "string"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "provider_fingerprint": {
          "type": "string"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "snapshot_cursor": {
          "format": "int64",
          "type": "integer"
        },
        "store_name": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "database_instance_id",
        "protocol_version",
        "schema_version",
        "generation",
        "fence_epoch",
        "snapshot_cursor",
        "provider",
        "provider_fingerprint",
        "corpus",
        "canonical_item_count",
        "canonical_digest",
        "delivery_item_count",
        "delivery_digest",
        "fingerprint"
      ],
      "type": "object"
    },
    "ProjectionCorpusMetadata": {
      "additionalProperties": false,
      "properties": {
        "corpus_fingerprint": {
          "type": "string"
        },
        "corpus_schema": {
          "type": "string"
        },
        "embedding_dimensions": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "embedding_model": {
          "type": "string"
        }
      },
      "required": [
        "corpus_schema",
        "corpus_fingerprint",
        "embedding_model",
        "embedding_dimensions"
      ],
      "type": "object"
    },
    "ProjectionPublishReceipt": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        },
        "retained_previous": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        }
      },
      "required": [
        "active",
        "retained_previous"
      ],
      "type": "object"
    },
    "ProjectionStoreDescriptor": {
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "$ref": "#/$defs/RequiredNullableSchema"
        },
        "provider": {
          "type": "string"
        },
        "provider_fingerprint": {
          "type": "string"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "store_name": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "schema_version",
        "provider",
        "provider_fingerprint",
        "corpus"
      ],
      "type": "object"
    },
    "RequiredNullableSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectionCorpusMetadata"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "RequiredNullableSchema2": {
      "description": "Schema-only marker for a key that is required but may contain JSON null.",
      "type": [
        "string",
        "null"
      ]
    },
    "RequiredNullableSchema3": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "VectorProjectionApplyBatchResponse": {
      "additionalProperties": false,
      "properties": {
        "ack": {
          "$ref": "#/$defs/VectorProjectionMutationAck"
        },
        "receipt": {
          "$ref": "#/$defs/VectorProjectionBatchApplicationReceipt"
        }
      },
      "required": [
        "ack",
        "receipt"
      ],
      "type": "object"
    },
    "VectorProjectionBatchApplicationReceipt": {
      "additionalProperties": false,
      "description": "Capability-free batch application evidence returned over helper stdout.\n\nThe caller reconstructs its in-process [`ProjectionBatchReceipt`] from the\noriginal request plus this evidence, so lease and claim tokens never cross\nthe stdout boundary.",
      "properties": {
        "applied_item_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "database_instance_id": {
          "type": "string"
        },
        "fence_epoch": {
          "format": "int64",
          "type": "integer"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "provider_fingerprint": {
          "type": "string"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "store_name": {
          "type": "string"
        },
        "target_generation": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "database_instance_id",
        "protocol_version",
        "schema_version",
        "provider",
        "provider_fingerprint",
        "target_generation",
        "fence_epoch",
        "applied_item_count"
      ],
      "type": "object"
    },
    "VectorProjectionCleanupResponse": {
      "additionalProperties": false,
      "properties": {
        "ack": {
          "$ref": "#/$defs/VectorProjectionMutationAck"
        },
        "dry_run": {
          "type": "boolean"
        },
        "protected_generations": {
          "items": {
            "$ref": "#/$defs/VectorProjectionProtectedGeneration"
          },
          "type": "array"
        },
        "removed_generations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skipped_generations": {
          "items": {
            "$ref": "#/$defs/VectorProjectionSkippedGeneration"
          },
          "type": "array"
        }
      },
      "required": [
        "ack",
        "dry_run",
        "removed_generations",
        "protected_generations",
        "skipped_generations"
      ],
      "type": "object"
    },
