{
  "$defs": {
    "CliBoardConfigSelection": {
      "additionalProperties": false,
      "description": "本地项目配置中的 active board 选择。\n\n该 DTO 不包含 canonical board record；`board use/current` 只读写 `.kb/config.toml`，\n因此不能伪装成需要 host/数据库查询的 `ApiBoard`。`created` 和 `updated` 记录本次\n配置侧调用是否创建了文件、是否实际改变了 `board` 选择。",
      "properties": {
        "board": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/CliConfigSource"
        },
        "updated": {
          "type": "boolean"
        }
      },
      "required": [
        "board",
        "config_path",
        "source",
        "created",
        "updated"
      ],
      "type": "object"
    },
    "CliConfigSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "flag",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "env",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "project_config",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "global_config",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:kanban-tool:schema:cli:board-current-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/CliBoardConfigSelection"
    }
  },
  "required": [
    "data"
  ],
  "title": "Kanban CLI board current output v1",
  "type": "object"
}
