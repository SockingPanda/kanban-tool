{
  "name": "@kanban-tool/web",
  "private": true,
  "license": "Apache-2.0",
  "version": "3.1.0",
  "type": "module",
  "astryx": {
    "theme": "./src/theme/astryx.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "build": "pnpm typecheck && pnpm vite-build",
    "lint": "eslint .",
    "astryx:component": "astryx --json component",
    "astryx:doctor": "astryx --json doctor",
    "astryx:manifest": "astryx --json manifest",
    "astryx:search": "astryx --json search",
    "astryx:templates": "astryx --json template --list",
    "theme:build": "astryx theme build src/theme/astryx.ts",
    "theme:check": "astryx theme build src/theme/astryx.ts --check",
    "e2e": "playwright test",
    "e2e:plane": "playwright test --config playwright.plane.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:ai": "storybook ai",
    "storybook:cli": "STORYBOOK_FEATURE_AI_CLI=1 storybook ai -p 6006",
    "storybook:build": "storybook build --output-dir ../../output/storybook",
    "test": "vitest run src build --passWithNoTests",
    "ui-guard": "vitest run build/ui-guard.test.ts --passWithNoTests",
    "ui-guard:enforce": "UI_GUARD_MODE=enforce vitest run build/ui-guard.test.ts --passWithNoTests",
    "typecheck": "tsc -b",
    "vite-build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@astryxdesign/theme-neutral": "0.3.0",
    "@stylexjs/stylex": "0.19.0",
    "ajv": "8.20.0",
    "json-schema-to-ts": "3.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.3.0",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "storybook": "10.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "8.2.1",
    "vitest": "^4.1.8"
  }
}
