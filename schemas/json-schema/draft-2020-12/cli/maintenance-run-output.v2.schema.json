{
  "$defs": {
    "CliMaintenanceMode": {
      "enum": [
        "once",
        "continuous"
      ],
      "type": "string"
    },
    "CliMaintenanceRun": {
      "additionalProperties": false,
      "properties": {
        "database_instance_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/CliMaintenanceMode"
        },
        "owner": {
          "type": "string"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "stores": {
          "items": {
            "$ref": "#/$defs/CliMaintenanceStoreRun"
          },
          "type": "array"
        }
      },
      "required": [
        "database_instance_id",
        "protocol_version",
        "owner",
        "mode",
        "stores"
      ],
      "type": "object"
    },
    "CliMaintenanceStoreFailureKind": {
      "enum": [
        "provider",
        "backend",
        "delivery"
      ],
      "type": "string"
    },
    "CliMaintenanceStoreResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string"
            },
            "processed": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "status": {
              "const": "succeeded",
              "type": "string"
            }
          },
          "required": [
            "status",
            "action",
            "processed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "$ref": "#/$defs/CliMaintenanceStoreFailureKind"
            },
            "message": {
              "type": "string"
            },
            "status": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "kind",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "CliMaintenanceStoreRun": {
      "additionalProperties": false,
      "properties": {
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle_status": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/CliMaintenanceStoreResult"
        },
        "store_name": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "result",
        "lifecycle_status",
        "fallback_reason"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:cli:maintenance-run-output:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/CliMaintenanceRun"
    }
  },
  "required": [
    "data"
  ],
  "title": "Kanban CLI maintenance run output v2",
  "type": "object"
}
