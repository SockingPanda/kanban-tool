{
  "$defs": {
    "ApiCycleStatus": {
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "ApiCycleSummary": {
      "additionalProperties": false,
      "properties": {
        "archived_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "board_id": {
          "type": "string"
        },
        "closed_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "ends_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "started_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "starts_at": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ApiCycleStatus"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "board_id",
        "title",
        "version",
        "created_at",
        "updated_at",
        "archived_at",
        "status",
        "starts_at",
        "ends_at",
        "started_at",
        "closed_at"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:api:list-cycles-response:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/ApiCycleSummary"
      },
      "type": "array"
    },
    "limit": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "offset": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "total": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "data",
    "total",
    "limit",
    "offset"
  ],
  "title": "api.list-cycles.response",
  "type": "object"
}
