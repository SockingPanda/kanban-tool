{
  "$defs": {
    "ApiErrorCode": {
      "enum": [
        "not_found",
        "conflict",
        "dependency_cycle",
        "invalid_input",
        "execution_plan_required",
        "steps_incomplete",
        "claim_token_mismatch",
        "dependency_blocked",
        "claim_conflict",
        "invalid_transition",
        "internal"
      ],
      "type": "string"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ApiErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:api:error-response:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "error"
  ],
  "title": "Kanban API error response v1",
  "type": "object"
}
