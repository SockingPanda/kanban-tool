{
  "$defs": {
    "ProjectionArtifactEvidence": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ProjectionArtifactManifest"
        }
      },
      "required": [
        "manifest",
        "fingerprint"
      ],
      "type": "object"
    },
    "ProjectionArtifactManifest": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest": {
          "type": "string"
        },
        "canonical_item_count": {
          "format": "int64",
          "type": "integer"
        },
        "corpus": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "database_instance_id": {
          "type": "string"
        },
        "delivery_digest": {
          "type": "string"
        },
        "delivery_item_count": {
          "format": "int64",
          "type": "integer"
        },
        "fence_epoch": {
          "format": "int64",
          "type": "integer"
        },
        "fingerprint": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        },
        "generation": {
          "type": "string"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "provider_fingerprint": {
          "type": "string"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "snapshot_cursor": {
          "format": "int64",
          "type": "integer"
        },
        "store_name": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "database_instance_id",
        "protocol_version",
        "schema_version",
        "generation",
        "fence_epoch",
        "snapshot_cursor",
        "provider",
        "provider_fingerprint",
        "corpus",
        "canonical_item_count",
        "canonical_digest",
        "delivery_item_count",
        "delivery_digest",
        "fingerprint"
      ],
      "type": "object"
    },
    "ProjectionBatch": {
      "additionalProperties": false,
      "description": "Exact stdin representation of a fenced Projection v2 delivery batch.\n\n`lease_token` and `claim_token` are opaque capabilities. Callers must pass\nthem over stdin only and must not log, persist or echo them through helper\nstdout.",
      "properties": {
        "claim_expires_at": {
          "format": "int64",
          "type": "integer"
        },
        "claim_token": {
          "type": "string"
        },
        "database_instance_id": {
          "type": "string"
        },
        "fence_epoch": {
          "format": "int64",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ProjectionDelivery"
          },
          "type": "array"
        },
        "lease_token": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "provider_fingerprint": {
          "type": "string"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "store_name": {
          "type": "string"
        },
        "target_generation": {
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "database_instance_id",
        "protocol_version",
        "schema_version",
        "provider",
        "provider_fingerprint",
        "owner",
        "lease_token",
        "fence_epoch",
        "target_generation",
        "claim_token",
        "claim_expires_at",
        "items"
      ],
      "type": "object"
    },
    "ProjectionCorpusMetadata": {
      "additionalProperties": false,
      "properties": {
        "corpus_fingerprint": {
          "type": "string"
        },
        "corpus_schema": {
          "type": "string"
        },
        "embedding_dimensions": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "embedding_model": {
          "type": "string"
        }
      },
      "required": [
        "corpus_schema",
        "corpus_fingerprint",
        "embedding_model",
        "embedding_dimensions"
      ],
      "type": "object"
    },
    "ProjectionDelivery": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ProjectionDeliveryAction"
        },
        "attempts": {
          "format": "int64",
          "type": "integer"
        },
        "board_id": {
          "type": "string"
        },
        "cursor": {
          "format": "int64",
          "type": "integer"
        },
        "entity_uri": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "outbox_id": {
          "format": "int64",
          "type": "integer"
        },
        "payload_json": {
          "type": "string"
        },
        "source_event_id": {
          "$ref": "#/$defs/RequiredNullableSchema5"
        },
        "store_name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "outbox_id",
        "store_name",
        "generation_id",
        "board_id",
        "source_event_id",
        "cursor",
        "action",
        "entity_uri",
        "payload_json",
        "attempts"
      ],
      "type": "object"
    },
    "ProjectionDeliveryAction": {
      "enum": [
        "upsert",
        "delete",
        "rebuild"
      ],
      "type": "string"
    },
    "ProjectionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/ProjectionArtifactManifest"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ProjectionSnapshotRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "manifest",
        "records"
      ],
      "type": "object"
    },
    "ProjectionSnapshotRecord": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "payload_json": {
          "type": "string"
        }
      },
      "required": [
        "board_id",
        "identity",
        "payload_json",
        "content_hash"
      ],
      "type": "object"
    },
    "RequiredNullableSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectionArtifactManifest"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "RequiredNullableSchema2": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectionCorpusMetadata"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "RequiredNullableSchema3": {
      "description": "Schema-only marker for a key that is required but may contain JSON null.",
      "type": [
        "string",
        "null"
      ]
    },
    "RequiredNullableSchema4": {
      "anyOf": [
        {
          "$ref": "#/$defs/VectorProjectionGenerationBinding"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "RequiredNullableSchema5": {
      "description": "Schema-only marker for a key that is required but may contain JSON null.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "RequiredNullableSchema6": {
      "anyOf": [
        {
          "$ref": "#/$defs/VectorProjectionBuildingPhase"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "RequiredNullableSchema7": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-only marker for a key that is required but may contain JSON null."
    },
    "VectorProjectionApplyBatchRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/VectorProjectionDestructiveAuthority",
          "description": "Exact DB-scoped operation authority for the generation being mutated.\nThe batch retains its delivery claim capability separately; both\ncapabilities are checked before any Lance rows or state are changed."
        },
        "batch": {
          "$ref": "#/$defs/ProjectionBatch"
        },
        "context": {
          "$ref": "#/$defs/VectorProjectionMutationContext"
        }
      },
      "required": [
        "context",
        "authority",
        "batch"
      ],
      "type": "object"
    },
    "VectorProjectionBuildingPhase": {
      "enum": [
        "snapshotting",
        "prepared",
        "store_published"
      ],
      "type": "string"
    },
    "VectorProjectionCleanupProtection": {
      "additionalProperties": false,
      "properties": {
        "active_generation": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        },
        "additional_generations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "building_generation": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        },
        "previous_generation": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        }
      },
      "required": [
        "active_generation",
        "previous_generation",
        "building_generation",
        "additional_generations"
      ],
      "type": "object"
    },
    "VectorProjectionCleanupRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/VectorProjectionDestructiveAuthority"
        },
        "context": {
          "$ref": "#/$defs/VectorProjectionMutationContext"
        },
        "dry_run": {
          "type": "boolean"
        },
        "protection": {
          "$ref": "#/$defs/VectorProjectionCleanupProtection"
        }
      },
      "required": [
        "context",
        "authority",
        "dry_run",
        "protection"
      ],
      "type": "object"
    },
    "VectorProjectionDescriptorRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "type": "object"
    },
    "VectorProjectionDestructiveAuthority": {
      "additionalProperties": false,
      "description": "Current lease capability plus the exact SQLite generation snapshot that\nauthorizes one destructive helper mutation.\n\nThe context digest is correlation evidence only. `lease_token` is the\nopaque capability and must never be rendered in diagnostics.",
      "properties": {
        "building_phase": {
          "$ref": "#/$defs/RequiredNullableSchema6"
        },
        "expected_binding": {
          "$ref": "#/$defs/RequiredNullableSchema4"
        },
        "expected_manifest": {
          "$ref": "#/$defs/RequiredNullableSchema"
        },
        "fence_epoch": {
          "format": "int64",
          "type": "integer"
        },
        "generation": {
          "type": "string"
        },
        "lease_token": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/VectorProjectionGenerationRole"
        }
      },
      "required": [
        "owner",
        "lease_token",
        "fence_epoch",
        "role",
        "generation",
        "expected_manifest",
        "expected_binding",
        "building_phase"
      ],
      "type": "object"
    },
    "VectorProjectionGenerationBinding": {
      "additionalProperties": false,
      "description": "Exact persisted generation binding used for destructive compare-and-swap.\n\n`fingerprint` and `snapshot_cursor` remain required-nullable because a\n`snapshotting` building generation has not produced those values yet.",
      "properties": {
        "canonical_count": {
          "format": "int64",
          "type": "integer"
        },
        "canonical_digest": {
          "type": "string"
        },
        "corpus": {
          "$ref": "#/$defs/RequiredNullableSchema2"
        },
        "delivery_count": {
          "format": "int64",
          "type": "integer"
        },
        "delivery_digest": {
          "type": "string"
        },
        "fence_epoch": {
          "format": "int64",
          "type": "integer"
        },
        "fingerprint": {
          "$ref": "#/$defs/RequiredNullableSchema3"
        },
        "generation": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_fingerprint": {
          "type": "string"
        },
        "snapshot_cursor": {
          "$ref": "#/$defs/RequiredNullableSchema5"
        }
      },
      "required": [
        "generation",
        "fingerprint",
        "fence_epoch",
        "snapshot_cursor",
        "provider",
        "provider_fingerprint",
        "canonical_count",
        "canonical_digest",
        "delivery_count",
        "delivery_digest",
        "corpus"
      ],
      "type": "object"
    },
    "VectorProjectionGenerationMutationRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/VectorProjectionDestructiveAuthority"
