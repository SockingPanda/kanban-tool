      "enum": [
        "active",
        "previous",
        "building",
        "prepared",
        "quarantined",
        "orphaned"
      ],
      "type": "string"
    },
    "VectorProjectionHelperDescriptor": {
      "additionalProperties": false,
      "properties": {
        "build_identity": {
          "type": "string"
        },
        "protocol_version": {
          "format": "int64",
          "type": "integer"
        },
        "request_id": {
          "type": "string"
        },
        "supported_operations": {
          "items": {
            "$ref": "#/$defs/VectorProjectionHelperOperation"
          },
          "type": "array"
