            "kind": {
              "const": "project_config",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "global_config",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
