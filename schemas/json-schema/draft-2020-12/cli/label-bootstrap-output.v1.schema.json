{
  "$defs": {
    "ApiExecutionPlanState": {
      "enum": [
        "unplanned",
        "planned",
        "not_required"
      ],
      "type": "string"
    },
    "ApiLabel": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "type": "string"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "board_id",
        "name",
        "color",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "ApiTask": {
      "additionalProperties": false,
      "properties": {
        "archived_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        },
        "board_id": {
          "type": "string"
        },
        "board_slug": {
          "type": "string"
        },
        "claim_expires_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "claim_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "completed_required_step_count": {
          "format": "int64",
          "type": "integer"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "created_by": {
          "type": "string"
        },
        "current_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependency_blocked": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "execution_plan_state": {
          "$ref": "#/$defs/ApiExecutionPlanState"
        },
        "id": {
          "type": "string"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/ApiLabel"
          },
          "type": "array"
        },
        "last_heartbeat_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lock_version": {
          "format": "int64",
          "type": "integer"
        },
        "max_retries": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "metadata": true,
        "optional_step_count": {
          "format": "int64",
          "type": "integer"
        },
        "position": {
          "format": "int64",
          "type": "integer"
        },
        "priority": {
          "$ref": "#/$defs/ApiTaskPriority"
        },
        "ref": {
          "type": "string"
        },
        "required_step_count": {
          "format": "int64",
          "type": "integer"
        },
        "result": true,
        "result_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_count": {
          "format": "int64",
          "type": "integer"
        },
        "scheduled_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "started_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ApiTaskStatus"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "unfinished_parent_count": {
          "format": "int64",
          "type": "integer"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "board_id",
        "board_slug",
        "ref",
        "seq",
        "title",
        "description",
        "status",
        "status_reason",
        "assignee",
        "priority",
        "position",
        "scheduled_at",
        "due_at",
        "created_by",
        "created_at",
        "updated_at",
        "started_at",
        "completed_at",
        "archived_at",
        "claim_owner",
        "claim_expires_at",
        "last_heartbeat_at",
        "current_run_id",
        "retry_count",
        "max_retries",
        "result_summary",
        "result",
        "metadata",
        "lock_version",
        "dependency_blocked",
        "unfinished_parent_count",
        "execution_plan_state",
        "required_step_count",
        "completed_required_step_count",
        "optional_step_count",
        "labels"
      ],
      "type": "object"
    },
    "ApiTaskPriority": {
      "format": "uint8",
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "ApiTaskStatus": {
      "enum": [
        "triage",
        "todo",
        "scheduled",
        "ready",
        "running",
        "blocked",
        "review",
        "done",
        "archived"
      ],
      "type": "string"
    },
    "CliLabelBootstrapResult": {
      "additionalProperties": false,
      "properties": {
        "semantics": {
          "$ref": "#/$defs/LabelSemanticsWire"
        },
        "task": {
          "$ref": "#/$defs/ApiTask"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/CliLabelBootstrapVerification"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task",
        "semantics",
        "verification"
      ],
      "type": "object"
    },
    "CliLabelBootstrapVerification": {
      "additionalProperties": false,
      "properties": {
        "degraded": {
          "type": "boolean"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label_name": {
          "type": "string"
        },
        "min_score": {
          "format": "float",
          "type": "number"
        },
        "score": {
          "format": "float",
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "label_name",
        "score",
        "source",
        "min_score",
        "degraded",
        "diagnostics"
      ],
      "type": "object"
    },
    "LabelAtomWire": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label_id": {
          "type": "string"
        },
        "label_name": {
          "type": "string"
        },
        "ordinal": {
          "format": "int64",
          "type": "integer"
        },
        "polarity": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label_id",
        "board_id",
        "label_name",
        "polarity",
        "kind",
        "text",
        "ordinal",
        "content_hash",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "LabelSemanticsWire": {
      "additionalProperties": false,
      "properties": {
        "applies_when": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "atoms": {
          "items": {
            "$ref": "#/$defs/LabelAtomWire"
          },
          "type": "array"
        },
        "board_id": {
          "type": "string"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "excludes_when": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label_id": {
          "type": "string"
        },
        "label_name": {
          "type": "string"
        },
        "negative_examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "positive_examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "semantics_hash": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "label_id",
        "board_id",
        "label_name",
        "semantics_hash",
        "description",
        "applies_when",
        "excludes_when",
        "positive_examples",
        "negative_examples",
        "created_at",
        "updated_at",
        "atoms"
      ],
      "type": "object"
    }
  },
  "$id": "urn:kanban-tool:schema:cli:label-bootstrap-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/CliLabelBootstrapResult"
    }
  },
  "required": [
    "data"
  ],
  "title": "Kanban CLI label bootstrap output v1",
  "type": "object"
}
