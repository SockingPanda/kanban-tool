      "required": [
        "context",
        "authority"
      ],
      "type": "object"
    },
    "VectorProjectionGenerationRole": {
      "enum": [
        "active",
        "previous",
        "building",
        "orphaned"
      ],
      "type": "string"
    },
    "VectorProjectionInspectActiveRequest": {
      "additionalProperties": false,
      "properties": {
