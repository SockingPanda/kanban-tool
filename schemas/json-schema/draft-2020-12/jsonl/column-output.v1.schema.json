{
  "$defs": {
    "ColumnJsonlData": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "type": "string"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "position": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PortableTaskStatus"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        },
        "wip_limit": {
