    "VectorProjectionPrepareSnapshotRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/VectorProjectionDestructiveAuthority",
          "description": "DB-scoped lease/generation capability for the physical snapshot\nmaterialization.  The helper must compare this capability with the\nSQLite authority after acquiring its `${store}-projection-helper`\nlock; the mutation context alone is correlation evidence."
        },
        "context": {
          "$ref": "#/$defs/VectorProjectionMutationContext"
        },
        "metadata": {
          "$ref": "#/$defs/ProjectionCorpusMetadata"
        },
        "snapshot": {
          "$ref": "#/$defs/ProjectionSnapshot"
        }
      },
      "required": [
        "context",
        "authority",
        "snapshot",
        "metadata"
      ],
      "type": "object"
    },
    "VectorProjectionPublishRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/VectorProjectionDestructiveAuthority"
        },
        "context": {
          "$ref": "#/$defs/VectorProjectionMutationContext"
        },
        "expected_active": {
          "$ref": "#/$defs/RequiredNullableSchema7"
        },
        "prepared": {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        }
      },
      "required": [
        "context",
        "authority",
        "expected_active",
        "prepared"
      ],
      "type": "object"
    },
    "VectorProjectionRepairPublicationRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/VectorProjectionDestructiveAuthority"
        },
        "context": {
          "$ref": "#/$defs/VectorProjectionMutationContext"
        },
        "expected": {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        }
      },
      "required": [
        "context",
        "authority",
        "expected"
      ],
      "type": "object"
    },
    "VectorProjectionValidateActiveRequest": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        },
        "projection_store": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "projection_store",
        "active"
      ],
      "type": "object"
    },
    "VectorProjectionValidateGenerationRequest": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "$ref": "#/$defs/ProjectionArtifactEvidence"
        },
        "projection_store": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "projection_store",
        "expected"
      ],
      "type": "object"
    }
  },
