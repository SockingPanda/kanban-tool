{
  "name": "@kanban-tool/grpc-framework",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./atlas-client": "./src/atlas-client.ts"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.core.json",
    "test": "pnpm build && node --test tests/*.test.mjs tests/generated/*.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.15.0",
    "typescript": "5.8.3"
  }
}
