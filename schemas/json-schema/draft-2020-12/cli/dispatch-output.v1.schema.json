{
  "$defs": {
    "CliDispatchLoopResult": {
      "additionalProperties": false,
      "properties": {
        "claimed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "iterations": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/CliDispatchRunResult"
          },
          "type": "array"
        },
        "stop_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/CliDispatchStopReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "iterations",
        "claimed",
        "runs"
      ],
      "type": "object"
    },
    "CliDispatchResult": {
      "anyOf": [
        {
          "$ref": "#/$defs/CliDispatchRunResult"
        },
        {
          "$ref": "#/$defs/CliDispatchLoopResult"
        }
      ]
    },
    "CliDispatchRunResult": {
      "additionalProperties": false,
      "properties": {
        "claimed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "claimed",
        "task_id",
        "run_id",
        "exit_code"
      ],
      "type": "object"
    },
    "CliDispatchStopReason": {
      "enum": [
        "interrupted"
      ],
      "type": "string"
    }
  },
  "$id": "urn:kanban-tool:schema:cli:dispatch-output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/CliDispatchResult"
    }
  },
  "required": [
    "data"
  ],
  "title": "Kanban CLI dispatch output v1",
  "type": "object"
}
