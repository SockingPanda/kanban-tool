          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "observation_id": {
          "type": "string"
        },
        "review_reason": {
          "description": "wire 上必须存在的 key，但其值可以明确为 JSON `null`。",
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "description": "wire 上必须存在的 key，但其值可以明确为 JSON `null`。",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "reviewed_by": {
          "description": "wire 上必须存在的 key，但其值可以明确为 JSON `null`。",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SignalStatus"
        },
        "summary": {
          "type": "string"
        },
        "superseded_by_signal_id": {
          "description": "wire 上必须存在的 key，但其值可以明确为 JSON `null`。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "board_id",
        "observation_id",
        "kind",
        "title",
        "summary",
        "severity",
        "status",
        "dedupe_key",
        "superseded_by_signal_id",
        "reviewed_by",
        "reviewed_at",
        "review_reason",
        "created_at",
        "updated_at"
