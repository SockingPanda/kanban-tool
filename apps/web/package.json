{
  "name": "@kanban-tool/web",
  "private": true,
  "license": "Apache-2.0",
  "version": "3.0.0",
  "type": "module",
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "build": "pnpm typecheck && pnpm vite-build",
    "lint": "eslint .",
    "astryx:doctor": "astryx --json doctor",
    "astryx:templates": "astryx --json template --list",
    "e2e": "playwright test",
    "test": "vitest run src build --passWithNoTests",
    "typecheck": "tsc -b",
    "vite-build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@astryxdesign/theme-neutral": "0.3.0",
    "@stylexjs/stylex": "0.19.0",
    "ajv": "8.20.0",
    "json-schema-to-ts": "3.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.3.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "8.2.1",
    "vitest": "^4.1.8"
  }
}
